# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Branding assets (source files / working copies — keep out of git)
/branding/

# Optional local install of dormant npm packages (manifest: docs/legacy-npm-deps/)
/optional/legacy-npm-deps/

# misc
.claude/
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files with secrets — never commit (use env-template.txt as the shared template)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# vercel
.vercel

# Supabase CLI (linked project metadata; may include secrets)
.supabase/
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry build plugin auth token (never commit)
.env.sentry-build-plugin
